      "outcome": "fail",
      "findings": [
        {
          "check": "sampling.tool-results-only",
          "seq": 1,
          "detail": "`inputRequests[forecast]` (`sampling/createMessage`)'s `messages[2]` mixes tool results with other content"
        }
      ],
      "source": {
        "section": "client/sampling#tool-result-messages",
        "quote": "When a user message contains tool results (type: \"tool_result\"), it MUST contain ONLY tool results.",
        "url": "https://modelcontextprotocol.io/specification/2026-07-28/client/sampling#tool-result-messages"
      }
    },
    {
      "id": "SAMP-031",
      "level": "MUST",
      "outcome": "fail",
      "findings": [
        {
          "check": "sampling.tool-use-answered",
          "seq": 1,
          "detail": "`inputRequests[forecast]` (`sampling/createMessage`)'s `messages[1]` is followed by a message that is not a user message of tool results only"
        }
      ],
      "source": {
        "section": "client/sampling#tool-use-and-result-balance",
        "quote": "When using tool use in sampling, every assistant message containing `ToolUseContent` blocks MUST be followed by a user message that consists entirely of `ToolResultContent` blocks, with each tool use (e.g. with `id: $id`) matched by a corresponding tool result (with `toolUseId: $id`), before any other message.",
        "url": "https://modelcontextprotocol.io/specification/2026-07-28/client/sampling#tool-use-and-result-balance"
      }
    },
