/target

# Environment secrets
.env
.env.*

# IDE directories
.idea/
.vscode/
*.iml

# macOS artifacts
.DS_Store

# Editor swap files
*.swp
*.swo

# cargo-mutants output
mutants.out/
mutants.out.old/

# The pmcp harness is its own non-workspace project (docs/reports/pmcp-harness),
# so the root-anchored `/target` above does not cover it — building the artifact
# once dropped its whole target/ tree into `git add`. Its Cargo.lock IS tracked:
# the harness is the evidence for a dated measurement, and a measurement nobody
# can reproduce is an anecdote.
docs/reports/pmcp-harness/target/

# cargo-fuzz build/findings output (fuzz/ is its own workspace)
fuzz/target/
fuzz/artifacts/
fuzz/coverage/

# libFuzzer-discovered corpus entries (hash-named) stay local; only curated
# seed-* files are tracked. Interesting discoveries get promoted to seeds
# deliberately, not committed wholesale.
fuzz/corpus/*/*
!fuzz/corpus/*/seed-*

# mdBook rendered output (the book sources under book/src are tracked)
/book/book/

# Python bytecode: `tools/extract-clauses.py` is importable (its `--verify` mode
# reuses the same normalizer the extraction path does), so running it as a module
# leaves a cache directory behind.
__pycache__/
