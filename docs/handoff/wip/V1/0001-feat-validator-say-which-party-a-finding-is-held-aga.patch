+
+#[test]
+fn a_both_parties_clause_is_held_against_the_sender_of_the_message() {
+    let life_009 = findings_of("LIFE-009");
+    let held: Vec<(Option<u64>, Option<Party>)> = life_009
+        .iter()
+        .map(|finding| (finding.seq, finding.party))
+        .collect();
+    assert_eq!(
