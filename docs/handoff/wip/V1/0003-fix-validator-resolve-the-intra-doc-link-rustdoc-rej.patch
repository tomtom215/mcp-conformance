From a8a071a6178109d5142b637810976c833e0c43c9 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 08:19:44 +0000
Subject: [PATCH 3/5] fix(validator): resolve the intra-doc link rustdoc
 rejects

`MultiRow::actor`'s doc linked `RequirementReport::actor` by bare name, which
is not in `multi`'s scope, so `cargo doc` with `-D warnings` failed on the
broken intra-doc link. Link it by path.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Sdg4tfY3zMjTpYqmDkiuqW
---
 crates/mcp-trace-validator/src/multi.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/crates/mcp-trace-validator/src/multi.rs b/crates/mcp-trace-validator/src/multi.rs
index eb21d5a..50e768f 100644
--- a/crates/mcp-trace-validator/src/multi.rs
+++ b/crates/mcp-trace-validator/src/multi.rs
@@ -84,7 +84,7 @@ pub struct MultiRow {
     /// The requirement's RFC 2119 level, as registry text (`"MUST"`, …).
     pub level: String,
     /// The party the clause binds, as the registry states it
-    /// ([`RequirementReport::actor`]).
+    /// ([`RequirementReport::actor`](crate::report::RequirementReport::actor)).
     #[serde(default, skip_serializing_if = "Option::is_none")]
     pub actor: Option<Actor>,
     /// Outcome under each judged revision, aligned by index with
