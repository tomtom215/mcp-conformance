diff --git a/crates/mcp-conformance-core/registry/2025-11-25/cancellation.json b/crates/mcp-conformance-core/registry/2025-11-25/cancellation.json
new file mode 100644
index 0000000..ef61080
--- /dev/null
+++ b/crates/mcp-conformance-core/registry/2025-11-25/cancellation.json
@@ -0,0 +1,130 @@
+{
+  "revision": "2025-11-25",
+  "requirements": [
+    {
+      "id": "CANC-018",
+      "level": "MUST",
+      "actor": "both",
+      "applies": {
+        "removed": "2026-07-28"
+      },
+      "source": {
+        "section": "basic/utilities/cancellation#behavior-requirements",
+        "quote": "Cancellation notifications MUST only reference requests that: Were previously issued in the same direction; Are believed to still be in-progress"
+      },
+      "checks": [
+        "cancellation.references-issued-request"
+      ]
+    },
+    {
+      "id": "CANC-019",
+      "level": "MUST NOT",
+      "actor": "client",
+      "applies": {
+        "removed": "2026-07-28"
+      },
+      "source": {
+        "section": "basic/utilities/cancellation#behavior-requirements",
+        "quote": "The `initialize` request MUST NOT be cancelled by clients"
+      },
+      "checks": [
+        "cancellation.initialize-not-cancelled"
+      ]
+    },
+    {
+      "id": "CANC-020",
+      "level": "MUST",
+      "actor": "both",
+      "applies": {
+        "removed": "2026-07-28"
+      },
+      "source": {
+        "section": "basic/utilities/cancellation#behavior-requirements",
+        "quote": "For task-augmented requests, the `tasks/cancel` request MUST be used instead of the `notifications/cancelled` notification."
+      },
+      "checks": [
+        "cancellation.task-cancelled-by-request"
+      ]
+    },
+    {
+      "id": "CANC-021",
+      "level": "SHOULD",
+      "actor": "both",
+      "applies": {
+        "removed": "2026-07-28"
+      },
+      "source": {
+        "section": "basic/utilities/cancellation#behavior-requirements",
+        "quote": "Receivers of cancellation notifications SHOULD: Stop processing the cancelled request; Free associated resources; Not send a response for the cancelled request"
+      },
+      "checks": [
+        "cancellation.no-response-after-cancellation"
+      ]
+    },
+    {
+      "id": "CANC-022",
+      "level": "SHOULD",
+      "actor": "both",
+      "applies": {
+        "removed": "2026-07-28"
+      },
+      "source": {
+        "section": "basic/utilities/cancellation#behavior-requirements",
+        "quote": "The sender of the cancellation notification SHOULD ignore any response to the request that arrives afterward"
+      },
+      "exclusion": "Ignoring a response is the absence of a reaction inside the sender. A recording would have to carry a message the sender sends because it acted on the late response, and the protocol defines none: nothing a party does with a response it received reaches the wire."
+    },
+    {
+      "id": "CANC-023",
+      "level": "MUST",
+      "actor": "both",
+      "applies": {
+        "removed": "2026-07-28"
+      },
+      "source": {
+        "section": "basic/utilities/cancellation#timing-considerations",
+        "quote": "Both parties MUST handle these race conditions gracefully:"
+      },
+      "exclusion": "Graceful handling is internal; the race itself is what a recording shows, and the checks are built not to convict it — `cancellation.no-response-after-cancellation` reports an answer to a cancelled request only once the receiver has demonstrably read the cancellation, and the conforming `stdio-cancellation` trace pins the answer that crosses one. A recording would have to carry a message the specification defines as ungraceful handling, and it defines none; a party that failed to handle the race would show it through some other clause's violation, judged there."
+    },
+    {
+      "id": "CANC-024",
+      "level": "SHOULD",
+      "actor": "both",
+      "applies": {
+        "removed": "2026-07-28"
+      },
+      "source": {
+        "section": "basic/utilities/cancellation#implementation-notes",
+        "quote": "Both parties SHOULD log cancellation reasons for debugging"
+      },
+      "exclusion": "Logging is local diagnostics with no wire footprint: nothing an implementation writes to its own log is a protocol message, so no recording contains it."
+    },
+    {
+      "id": "CANC-025",
+      "level": "SHOULD",
+      "actor": "client",
+      "applies": {
+        "removed": "2026-07-28"
+      },
+      "source": {
+        "section": "basic/utilities/cancellation#implementation-notes",
+        "quote": "Application UIs SHOULD indicate when cancellation is requested"
+      },
+      "exclusion": "User-interface presentation, out by strategy rule 2: what an application shows its user is not a protocol message, so no recording carries it."
+    },
+    {
+      "id": "CANC-026",
+      "level": "SHOULD",
+      "actor": "both",
+      "applies": {
+        "removed": "2026-07-28"
+      },
+      "source": {
+        "section": "basic/utilities/cancellation#error-handling",
+        "quote": "Invalid cancellation notifications SHOULD be ignored: Unknown request IDs; Already completed requests; Malformed notifications"
+      },
+      "exclusion": "Ignoring a notification is the absence of a reaction, which a trace cannot tell apart from the notification never mattering: a recording would have to carry a message the receiver sends because it did not ignore the notification, and the protocol defines none (answering a notification is forbidden anyway, BASE-011). The party that sent the invalid notification is judged instead, where it can be: CANC-018 for a cancellation naming a request its sender never issued in the session, CANC-019 for one naming `initialize`."
+    }
+  ]
+}
diff --git a/crates/mcp-conformance-core/registry/2025-11-25/ping.json b/crates/mcp-conformance-core/registry/2025-11-25/ping.json
new file mode 100644
index 0000000..169dad9
--- /dev/null
+++ b/crates/mcp-conformance-core/registry/2025-11-25/ping.json
@@ -0,0 +1,98 @@
+{
+  "revision": "2025-11-25",
+  "requirements": [
+    {
+      "id": "PING-001",
+      "level": "MUST",
+      "actor": "both",
+      "applies": {
+        "removed": "2026-07-28"
+      },
+      "source": {
+        "section": "basic/utilities/ping#behavior-requirements",
+        "quote": "The receiver MUST respond promptly with an empty response:"
+      },
+      "checks": [
+        "ping.empty-result"
+      ]
+    },
+    {
+      "id": "PING-002",
+      "level": "SHOULD",
+      "actor": "both",
+      "applies": {
+        "removed": "2026-07-28"
+      },
+      "source": {
+        "section": "basic/utilities/ping#implementation-considerations",
+        "quote": "Implementations SHOULD periodically issue pings to detect connection health"
+      },
+      "exclusion": "\"Periodically\" is a rate over wall-clock time, and checks may not consult time — the limit LIFE-015 records. A recording would have to show the interval between pings against the length of the session, and it carries neither: a session with no ping and one with few are both what a conforming implementation produces over a short enough connection."
+    },
+    {
+      "id": "PING-003",
+      "level": "SHOULD",
+      "actor": "both",
+      "applies": {
+        "removed": "2026-07-28"
+      },
+      "source": {
+        "section": "basic/utilities/ping#implementation-considerations",
+        "quote": "The frequency of pings SHOULD be configurable"
+      },
+      "exclusion": "Binds the implementation's configuration surface — what its operator can set — which has no protocol representation (LIFE-019's boundary). A recording shows the pings one configuration produced, never whether another was available."
+    },
+    {
+      "id": "PING-004",
+      "level": "SHOULD",
+      "actor": "both",
+      "applies": {
+        "removed": "2026-07-28"
+      },
+      "source": {
+        "section": "basic/utilities/ping#implementation-considerations",
+        "quote": "Timeouts SHOULD be appropriate for the network environment"
+      },
+      "exclusion": "A timeout is a duration held inside the sender, and checks may not consult time (LIFE-015). A recording would have to carry the deadline the sender held a ping to and the network it was chosen for; it shows a ping answered or not, and nothing of either."
+    },
+    {
+      "id": "PING-005",
+      "level": "SHOULD",
+      "actor": "both",
+      "applies": {
+        "removed": "2026-07-28"
+      },
+      "source": {
+        "section": "basic/utilities/ping#implementation-considerations",
+        "quote": "Excessive pinging SHOULD be avoided to reduce network overhead"
+      },
+      "exclusion": "\"Excessive\" is a rate — pings per unit of time — and checks may not consult time (LIFE-015). No count of pings alone separates a flood from a long session checking its connection, the same limit PROG-018 records for rate limiting."
+    },
+    {
+      "id": "PING-006",
+      "level": "SHOULD",
+      "actor": "both",
+      "applies": {
+        "removed": "2026-07-28"
+      },
+      "source": {
+        "section": "basic/utilities/ping#error-handling",
+        "quote": "Timeouts SHOULD be treated as connection failures"
+      },
+      "exclusion": "The antecedent, a ping timing out, is the sender's own deadline expiring, which no message records and checks may not compute from timestamps (LIFE-015). The consequence, treating the connection as failed, is at most a `transport-close` lifecycle event, which says that a transport ended and not why; a recording cannot tell a connection dropped for a timeout from one closed at the end of a session."
+    },
+    {
+      "id": "PING-007",
+      "level": "SHOULD",
+      "actor": "both",
+      "applies": {
+        "removed": "2026-07-28"
+      },
+      "source": {
+        "section": "basic/utilities/ping#error-handling",
+        "quote": "Implementations SHOULD log ping failures for diagnostics"
+      },
+      "exclusion": "Logging is local diagnostics with no wire footprint (CANC-024's boundary): nothing an implementation writes to its own log is a protocol message, so no recording contains it."
+    }
+  ]
+}
