#
# The cross-SDK matrix's pins, in one place: which release of each official
# SDK, which upstream commit its conformance server is taken from, and the
# SHA-256 of every file copied out of that commit. setup.sh sources this file
# and refuses to build when a package manager's own pin disagrees with it, and
# `cargo xtask sdk-matrix --check` (one of `cargo xtask gates`) refuses the
# same disagreement on every change, so the four lockfiles below cannot move
# without this file moving too:
#
#   TypeScript  package.json / package-lock.json (`npm ci`, integrity hashes)
#   Python      requirements.in / requirements.txt (`pip --require-hashes`)
#   Go          go/go.mod / go/go.sum (module checksums, sum.golang.org)
#   Rust        rust/Cargo.toml / rust/Cargo.lock (`cargo --locked`, crate checksums)
#
# `cargo xtask sdk-matrix` reads the versions from here for the book's matrix
# page. Plain KEY=value lines only: both bash and the xtask parse it.

# TypeScript SDK (@modelcontextprotocol/sdk). Its conformance server is
# test/conformance/src/everythingServer.ts at the release tag.
TS_SDK_VERSION=1.32.0
TS_SDK_REPO=https://github.com/modelcontextprotocol/typescript-sdk
TS_SDK_COMMIT=32549b00a9a808265f35a29f92fdf27fa4aac2ef
TS_SERVER_PATH=test/conformance/src/everythingServer.ts
TS_SERVER_SHA256=7b576322ab4e3a0f184dde09488aaa33504736a26c7ced173c9b927876daebfe

# Python SDK (mcp on PyPI). Its conformance server is the everything-server
# example at the release tag.
PY_SDK_VERSION=2.3.0
PY_SDK_REPO=https://github.com/modelcontextprotocol/python-sdk
PY_SDK_COMMIT=2118f14f8a19bc158d8a1cf90af58d85d187f849
PY_SERVER_PATH=examples/servers/everything-server/mcp_everything_server/server.py
PY_SERVER_SHA256=919efeca0037453ce9cda1187783da49987a7a93500c2455c7309d3c68eadb89

# Go SDK (github.com/modelcontextprotocol/go-sdk). Its conformance server
# ships inside the module (conformance/everything-server), so the module proxy
# and go.sum carry it: no copy, no separate hash.
GO_SDK_VERSION=v1.8.0

# Rust SDK (rmcp on crates.io). Its conformance server is
# conformance/src/bin/server.rs at the release tag, compiled against the
# published crate by rust/Cargo.toml.
RUST_SDK_VERSION=3.5.1
RUST_SDK_REPO=https://github.com/modelcontextprotocol/rust-sdk
RUST_SDK_COMMIT=79437f291b2c44053d00dcd5db969fd0cca7c887
RUST_SERVER_PATH=conformance/src/bin/server.rs
RUST_SERVER_SHA256=145b79b33b8f90de480a243da494f3c541564e61c3c5489dce5427a7a7be392e
